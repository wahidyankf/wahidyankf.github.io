{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "wahidyankf-github-io",
  "version": "0.1.0",
  "private": true,
  "description": "Personal site of Wahidyan Kresna Fridayoka, deployed to https://wahidyankf.github.io/ via GitHub Pages static hosting.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --port ${WAHIDYANKF_WWW_PORT:-3201}",
    "build": "next build",
    "start": "serve out --listen ${WAHIDYANKF_WWW_PORT:-3000}",
    "typecheck": "tsc --noEmit && tsc --project e2e/tsconfig.json --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:unit": "vitest run --project unit",
    "test:bdd": "vitest run --project behaviour-unit",
    "test:integration": "vitest run --project integration",
    "test:coverage:unit": "vitest run --project unit --project behaviour-unit --coverage --coverage.thresholds.lines=99",
    "test:coverage:integration": "vitest run --project integration --coverage --coverage.include='src/features/cv/**/pdf.ts' --coverage.thresholds.lines=99",
    "test:coverage:behaviour": "vitest run --project behaviour-unit",
    "test:coverage:behaviour:e2e": "node --test e2e/tools/behaviour-compliance.test.mjs && node e2e/tools/check-behaviour-compliance.mjs",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:integration && npm run test:coverage:behaviour && npm run test:coverage:behaviour:e2e",
    "test:e2e": "if grep -rnE '\\btest\\.(skip|only|fixme)\\s*\\(' e2e/tests; then echo 'ERROR: unconditional Playwright skip/focus marker found' >&2; exit 1; fi && playwright test --config e2e/playwright.config.ts",
    "install:e2e": "playwright install --with-deps chromium",
    "validate:static-routes": "node scripts/validate-static-routes.mjs",
    "generate:cv-pdf": "tsx scripts/generate-cv-pdf.ts",
    "test:quick": "npm run build && npm run validate:static-routes && npm run typecheck && npm run lint && npm run test:unit && npm run test:coverage:unit && npm run test:coverage:behaviour"
  },
  "dependencies": {
    "@next/third-parties": "16.4.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "clsx": "2.1.1",
    "dotenv": "18.0.6",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "7.0.0",
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.14.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "^17.6.0",
    "playwright-bdd": "9.2.1",
    "prettier": "^3.9.10",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  }
}
